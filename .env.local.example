# ---- Required ----
# OpenWeatherMap (free tier works): https://home.openweathermap.org/api_keys
NEXT_PUBLIC_WEATHER_API_KEY=your_openweathermap_api_key_here

# ---- AI panel (optional but recommended) ----
# xAI Grok key for the "Ask about tides, sightings, events…" command bar
GROK_API=your_xai_api_key_here

# ---- Location (optional; defaults are Union, WA on Hood Canal) ----
# NOAA CO-OPS tide station. Find another at https://tidesandcurrents.noaa.gov/map/
NEXT_PUBLIC_NOAA_STATION_ID=9445478
NEXT_PUBLIC_NOAA_STATION_NAME="Union, Hood Canal"
# Weather point (Alderbrook / Great Bend). Override if you move the display.
DASHBOARD_LAT=47.3583
DASHBOARD_LON=-123.0953

# ---- Events (optional) ----
# Extra events from a local agent; see data/hermes-events.example.json for the shape.
# Defaults to ./data/hermes-events.json if unset.
# HERMES_EVENTS_PATH=C:\path\to\hermes-events.json

# ---- Legacy / unused by the marine dashboard (older components only) ----
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# REPLICATE_API_TOKEN=
# DEEPGRAM_API_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_FIREBASE_API_KEY=

# Hermes "Local WA Events" page served from the MacBook Pro on the LAN (preferred events source).
# For the Vercel deployment this must be a publicly reachable URL (e.g. a cloudflared/ngrok tunnel).
HERMES_EVENTS_URL=http://192.168.40.77:8788/

# Shared secret Hermes sends in the X-Hermes-Secret header when it POSTs events to
# /api/hermes/events. Make up a long random string; set the same value in Vercel.
HERMES_PUSH_SECRET=change-me-to-a-long-random-string
# On Vercel, creating a Blob store on the project injects BLOB_READ_WRITE_TOKEN automatically;
# without it (local dev) pushed documents are written to data/hermes-events.{json,html}.
# BLOB_READ_WRITE_TOKEN=
